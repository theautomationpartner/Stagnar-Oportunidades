# Plantilla de variables de entorno. Copiar a .env (que NO se versiona) y completar.
# Las mismas van cargadas en Vercel > Settings > Environment Variables, para Production,
# Preview y Development.

# ─── Lo que la app ya usaba ───────────────────────────────────────────────────────────

MONDAY_API_KEY=
VITE_MONDAY_BOARD_ID=
VITE_MONDAY_SUBITEMS_BOARD_ID=
VITE_MAKE_WEBHOOK_URL=
MAKE_CARTA_AUTOMOVIL_WEBHOOK_URL=
MAKE_LEER_CEDULA_WEBHOOK_URL=

# ─── Autenticación ────────────────────────────────────────────────────────────────────

# LA PERILLA PRINCIPAL. Decide si la seguridad protege o solo observa:
#   off     el guardián no hace nada; la app se comporta como antes de instalar esto.
#   shadow  evalúa todo y lo registra en la tabla `auditoria`, pero deja pasar igual.
#           Es el paso intermedio: se despliega, se mira unos días quién habría quedado
#           afuera, se corrige la lista blanca, y recién ahí se pasa a `on`.
#   on      se aplica de verdad.
# Sin definir: `off` si no hay DATABASE_URL, `on` si la hay (ver api/_auth/env.js).
AUTH_ENFORCE=off

# Postgres. Neon y Supabase tienen plan gratuito suficiente para arrancar. Tiene que ser
# una URL que soporte HTTP (Neon nativo, o el pooler de Supabase): en serverless no se
# puede abrir una conexión TCP por invocación.
DATABASE_URL=

# Generar los dos con:  npm run auth:secretos
# ENCRYPTION_KEY: 64 caracteres hex (32 bytes). Cifra los secretos TOTP. Si se pierde,
# hay que resetear el 2FA de TODOS los usuarios. Guardar una copia fuera de Vercel.
ENCRYPTION_KEY=
# AUTH_SESSION_SECRET: firma las sesiones. Rotarla cierra todas las sesiones abiertas.
AUTH_SESSION_SECRET=

# El secreto con el que monday firma el sessionToken. Los dos están en el developer
# center, en "Basic Information" de la app. Cuál de los dos valida es la causa #1 de
# errores "invalid signature": poné los dos y el código prueba ambos, avisando por log
# cuál funcionó (ver api/_auth/mondaySession.js).
MONDAY_SIGNING_SECRET=
MONDAY_CLIENT_SECRET=
# El app_id de la app en monday. Opcional pero recomendado: rechaza tokens de otra app.
MONDAY_APP_ID=
# IDs de cuenta de monday habilitadas, separados por coma. Vacío = no se filtra por cuenta.
CUENTAS_HABILITADAS=

# ─── Lista blanca: tablero de monday ──────────────────────────────────────────────────
# "Usuario Habilitados - Lista Blanca". Es la fuente de verdad de quién entra y con qué
# rol; el cliente lo administra sin depender de un despliegue.
# IMPORTANTE: tiene que ser un tablero PRIVADO, visible solo para administradores. Quien
# pueda editarlo puede darse acceso a sí mismo.
# Todas tienen default en el código; solo hace falta ponerlas si cambian los ids.
# AUTH_LISTA_BLANCA_BOARD_ID=18409461390
# AUTH_COL_ID_USUARIO=text_mm6sdhy6      # "ID Usuario" — el user_id de monday, clave primaria
# AUTH_COL_EMAIL=email_mm6s3dc5          # "Correo electrónico" — respaldo
# AUTH_COL_ROL=color_mm72cf90            # "Rol" — Admin | Resto del equipo | Invitado
# AUTH_COL_TEAM=dropdown_mm72rsy7        # "Team" — no restringe nada hoy
# AUTH_COL_ESTADO=color_mm6sf2bt         # "Estado Usuario" — Activo | Inactivo
# AUTH_COL_ID_APP=dropdown_mm72afcm      # "ID app" — a qué apps entra esa persona

# Cuál app es ESTA. Se cruza contra la columna "ID app" del tablero: una fila solo habilita
# si incluye este id. Es lo que permite que una sola lista blanca sirva para varias apps.
# 18424652719 es el board custom_object "Oportunidades" (el objeto de la Vibe App en
# monday). NO confundir con VITE_MONDAY_BOARD_ID, que es el tablero de datos.
# Cuando se sume una app nueva: agregar su id como etiqueta en esa columna del tablero,
# marcársela a quien corresponda, y poner acá su id en el proyecto de Vercel de esa app.
# AUTH_APP_ID=18424652719
#
# Cuántos segundos vale la copia del tablero antes de volver a pedirlo. Es el retraso
# máximo entre pasar a alguien a Inactivo y que deje de entrar. Bajarlo cuesta cuota de la
# API de monday; subirlo alarga esa ventana.
# AUTH_LISTA_BLANCA_TTL=60

# ─── Rate limiting (opcional pero muy recomendado) ────────────────────────────────────
# Sin esto el límite igual funciona, contando en Postgres. Con Upstash es más rápido y no
# le pega a la base de la app en cada intento.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Ajustes finos (todos tienen default; dejar vacío está bien) ──────────────────────
# AUTH_SESSION_TTL_HORAS=24        # cuánto dura la sesión sin volver a pedir el 2FA
# AUTH_PREAUTH_TTL_MINUTOS=10
# AUTH_DEVICE_TTL_DIAS=1          # "no volver a preguntar": 1 = el código se pide una vez por día
# AUTH_TOTP_EMISOR=Stagnari          # lo que ve el usuario en Google Authenticator
# (la separación entre apps la resuelve AUTH_APP_ID + la columna "ID app", más arriba)

# ─── Proveedor "contraseña" (apagado; ver el punto 2.1 del documento) ─────────────────
# Encender SOLO el día que exista un acceso a la app fuera del iframe de monday. Mientras
# la app viva adentro de monday, esto es superficie de ataque sin ninguna función.
# Requiere las dos: la de servidor valida, la VITE_ hace que el frontend muestre el form.
# AUTH_PASSWORD_LOGIN=on
# VITE_AUTH_PASSWORD_LOGIN=on

# ─── Solo para desarrollo local ───────────────────────────────────────────────────────
# Permite ejercitar todo el flujo (lista blanca, selector de perfil, 2FA, permisos) desde
# localhost:5173, sin abrir la app dentro de monday — que es la única forma de conseguir un
# sessionToken real. El dev server firma uno con el mismo secreto de la app.
#
# NO existe en Vercel: el endpoint solo lo sirve el dev server de Vite, y la parte del
# frontend la elimina el build (verificado: no aparece en dist/).
#
# Las DOS hacen falta: la de servidor registra el endpoint, la VITE_ hace que el frontend
# lo use.
# AUTH_DEV_LOGIN=on
# VITE_AUTH_DEV_LOGIN=on
# A quién simular. Se puede pisar por URL: http://localhost:5173/?devUser=102989607
#   95773286  The Automation Partner (asiento compartido: 4 perfiles)
#   95774232  Marcel      · 95774235  Matias      · 102374916 Valentina
#   102989607 Juan        · 103213217 Daniella    · 111971504 Gonzalo
# AUTH_DEV_USER_ID=102989607
# El account_id se resuelve solo contra la API de monday si no se pone. Tiene que estar en
# el token: el guardián rechaza como incompleto uno sin cuenta, igual que haría con un token
# real mal formado.
# AUTH_DEV_ACCOUNT_ID=

# ─── Solo para Preview de Vercel ──────────────────────────────────────────────────────
# Desactiva el filtro por Referer del middleware, para poder abrir un Preview suelto y
# probarlo sin monday. NUNCA en Production.
# AUTH_MIDDLEWARE_REFERER=off
